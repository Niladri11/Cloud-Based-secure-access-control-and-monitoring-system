# Server
PORT=5000
NODE_ENV=production

# Database (MySQL / AWS RDS)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=12345
DB_NAME=secure_access_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=1h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5

# Admin
ADMIN_EMAIL=admin@yourdomain.com
